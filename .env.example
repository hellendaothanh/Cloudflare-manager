# Cloudflare DevSecOps Manager - Environment Variables

# Tùy chọn 1: Đặt cố định API Token cho môi trường Production / Nội bộ (Nếu không muốn nhập trên Navbar)
CLOUDFLARE_API_TOKEN=

# Tùy chọn 2: Cấu hình AI Copilot (Mặc định: Sử dụng Built-in Edge Rule Synthesizer không cần API Key ngoài)
# Nếu bạn muốn tích hợp thêm mô hình Cloudflare Workers AI hoặc OpenAI bên ngoài:
# OPENAI_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_TOKEN=
